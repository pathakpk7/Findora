# ==========================================
# FINDORA ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# 1. DATABASE (Supabase / PostgreSQL)
# ------------------------------------------
# PostgreSQL connection string with pooling or direct access
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Optional Supabase API keys (if using Supabase Auth/Storage SDK)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# ------------------------------------------
# 2. BACKEND & API CONFIGURATION
# ------------------------------------------
PORT=3001
API_PORT=3001
API_HOST=localhost
BACKEND_URL="http://localhost:3001"
NODE_ENV="development"

# ------------------------------------------
# 3. FRONTEND CONFIGURATION
# ------------------------------------------
# Used by frontend to call the backend API (in production, set to your backend domain, e.g. https://api.findora.com)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# CORS configuration: set to your frontend domain in production (e.g. https://findora.com)
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------
# 4. JWT AUTHENTICATION
# ------------------------------------------
# Strong secret key (min 32 characters) for signing session JWT tokens
JWT_SECRET="your_super_secret_jwt_key_at_least_32_characters"
JWT_EXPIRES_IN="7d"

# ------------------------------------------
# 5. CLOUDINARY (Media Storage)
# ------------------------------------------
# Required for signed image uploads of found items
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ------------------------------------------
# 6. AI MATCHING (Google Gemini) - Optional
# ------------------------------------------
# If not provided, Findora automatically uses its built-in rule-based deterministic matcher
GEMINI_API_KEY="your_gemini_api_key"

# ------------------------------------------
# 7. OPTIONAL SERVICES (Caching & SMTP)
# ------------------------------------------
REDIS_URL="redis://localhost:6379"

EMAIL_FROM="noreply@findora.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
