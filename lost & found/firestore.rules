rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Users Collection
    match /users/{userId} {
      // Authenticated users can view other user profiles (e.g., student name on listings)
      allow read: if isAuthenticated();
      // Any authenticated user can create their own profile document on registration
      allow create: if isOwner(userId);
      // Users can update their own profile, or admins can update any profile (e.g. promote role)
      allow update: if isOwner(userId) || isAdmin();
      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }

    // 2. Items Collection (Lost & Found Listings)
    match /items/{itemId} {
      // Anyone can browse lost and found items
      allow read: if true;
      // Authenticated students can create a listing under their own UID
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      // Only the listing owner or an administrator can update or delete
      allow update: if isOwner(resource.data.ownerId) || isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // 3. Claims Collection (Ownership Verification)
    // CRITICAL SECURITY: Confidential identifying proof must NEVER be exposed publicly.
    match /claims/{claimId} {
      // Only the claimant, the listing owner (finder), or an admin can read claim details
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.claimantId ||
        request.auth.uid == resource.data.ownerId ||
        isAdmin()
      );
      // Authenticated students can submit a claim under their own UID
      allow create: if isAuthenticated() && request.resource.data.claimantId == request.auth.uid;
      // The listing owner can approve/reject, claimant can cancel, admin can moderate
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid == resource.data.claimantId ||
        isAdmin()
      );
      // Only admins can delete claim records
      allow delete: if isAdmin();
    }

    // 4. Reports Collection (Content Moderation)
    match /reports/{reportId} {
      // Any authenticated user can report suspicious listings
      allow create: if isAuthenticated();
      // Only administrators can view, update, or dismiss reports
      allow read, update, delete: if isAdmin();
    }
  }
}
