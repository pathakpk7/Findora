# ==============================================================================
# FINDORA FRONTEND ENVIRONMENT TEMPLATE (FOR VERCEL DEPLOYMENT)
# ==============================================================================
# In Vercel (https://vercel.com):
# 1. Import your GitHub repository.
# 2. Set Framework Preset: Next.js
# 3. Set Root Directory: apps/frontend
# 4. In "Environment Variables", add:

# Render Backend API URL (without trailing slash)
NEXT_PUBLIC_API_URL=https://findora-api.onrender.com

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudinary Public Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
