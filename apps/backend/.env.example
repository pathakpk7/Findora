# ==============================================================================
# FINDORA BACKEND ENVIRONMENT TEMPLATE (FOR RENDER DEPLOYMENT)
# ==============================================================================
# In Render (https://dashboard.render.com):
# 1. Create a New Web Service pointing to your repo.
# 2. Set Root Directory: apps/backend
# 3. Build Command: npm install && npm run build
# 4. Start Command: npm run start:prod (or node dist/main.js)
# 5. Add the following Environment Variables in Render Dashboard -> Environment:

# Database Connection (Supabase PostgreSQL pooled connection URL)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Server Configuration (Render injects PORT automatically)
PORT=10000
NODE_ENV=production

# CORS Frontend URL (Your deployed Vercel domain)
FRONTEND_URL=https://findora.vercel.app

# JWT Configuration (Minimum 32 random characters)
JWT_SECRET=generate_a_secure_random_32_char_secret_here
JWT_EXPIRES_IN=7d

# Supabase Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI Matching
GEMINI_API_KEY=your_gemini_api_key
